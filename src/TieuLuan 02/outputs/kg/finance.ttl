@prefix ex: <http://tl02.ptit.local/kg#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Asset a rdfs:Class ;
    rdfs:subClassOf ex:FinancialEntity .

ex:Commodity a rdfs:Class ;
    rdfs:subClassOf ex:Asset .

ex:Event a rdfs:Class ;
    rdfs:subClassOf ex:FinancialEntity .

ex:Exchange a rdfs:Class ;
    rdfs:subClassOf ex:FinancialEntity .

ex:FinancialEntity a rdfs:Class ;
    rdfs:subClassOf ex:Thing .

ex:GlobalFactor a rdfs:Class ;
    rdfs:subClassOf ex:MacroFactor .

ex:GoldAsset a rdfs:Class ;
    rdfs:subClassOf ex:Commodity .

ex:Index a rdfs:Class ;
    rdfs:subClassOf ex:Asset .

ex:Indicator a rdfs:Class ;
    rdfs:subClassOf ex:FinancialEntity .

ex:MacroFactor a rdfs:Class ;
    rdfs:subClassOf ex:FinancialEntity .

ex:MarketFlow a rdfs:Class ;
    rdfs:subClassOf ex:MacroFactor .

ex:PolicyTool a rdfs:Class ;
    rdfs:subClassOf ex:MacroFactor .

ex:Regulation a rdfs:Class ;
    rdfs:subClassOf ex:FinancialEntity .

ex:Sector a rdfs:Class ;
    rdfs:subClassOf ex:FinancialEntity .

ex:Stock a rdfs:Class ;
    rdfs:subClassOf ex:Asset .

ex:Thing a rdfs:Class .

