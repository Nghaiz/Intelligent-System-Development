MATCH (a:Entity {uid: 'med_high::patient'}), (b:Entity {uid: 'med_high::bio_glucose'}) MERGE (a)-[r:HAS_BIOMARKER]->(b);
MATCH (a:Entity {uid: 'med_high::patient'}), (b:Entity {uid: 'med_high::bio_bmi'}) MERGE (a)-[r:HAS_BIOMARKER]->(b);
MATCH (a:Entity {uid: 'med_high::patient'}), (b:Entity {uid: 'med_high::bio_bloodpressure'}) MERGE (a)-[r:HAS_BIOMARKER]->(b);
MATCH (a:Entity {uid: 'med_high::patient'}), (b:Entity {uid: 'med_high::bio_interaction'}) MERGE (a)-[r:CALCULATED_RISK]->(b);
MATCH (a:Entity {uid: 'med_high::patient'}), (b:Entity {uid: 'med_high::model'}) MERGE (a)-[r:EVALUATED_BY]->(b);
MATCH (a:Entity {uid: 'med_high::model'}), (b:Entity {uid: 'med_high::prediction'}) MERGE (a)-[r:PRODUCES]->(b);
MATCH (a:Entity {uid: 'med_high::prediction'}), (b:Entity {uid: 'med_high::icd10'}) MERGE (a)-[r:MAPS_TO_DISEASE]->(b);
MATCH (a:Entity {uid: 'med_high::patient'}), (b:Entity {uid: 'med_high::tier_high'}) MERGE (a)-[r:STRATIFIED_AS]->(b);
MATCH (a:Entity {uid: 'med_high::icd10'}), (b:Entity {uid: 'med_high::device_0'}) MERGE (a)-[r:REQUIRES_DEVICE]->(b);
MATCH (a:Entity {uid: 'med_high::icd10'}), (b:Entity {uid: 'med_high::device_1'}) MERGE (a)-[r:REQUIRES_DEVICE]->(b);
MATCH (a:Entity {uid: 'med_high::icd10'}), (b:Entity {uid: 'med_high::device_2'}) MERGE (a)-[r:REQUIRES_DEVICE]->(b);
MATCH (a:Entity {uid: 'med_high::icd10'}), (b:Entity {uid: 'med_high::nutrition_0'}) MERGE (a)-[r:RECOMMENDS_NUTRITION]->(b);
