// Dán toàn bộ nội dung này vào Neo4j Browser rồi bấm Run.

CREATE CONSTRAINT entity_uid IF NOT EXISTS
FOR (n:Entity) REQUIRE n.uid IS UNIQUE;

MERGE (n:Entity {uid: 'med_high::patient'}) SET n:Patient, n += {`name`: 'Bệnh nhân', `kind`: 'Patient', `case`: 'med_high', `domain`: 'medical', `Tuổi`: 36.0, `Glucose`: 159.0, `BMI`: 30.4};
