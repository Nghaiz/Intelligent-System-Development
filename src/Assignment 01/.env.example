# ==========================================================================
#  MẪU CẤU HÌNH — chép file này thành .env rồi điền giá trị thật
#  File .env đã bị .gitignore chặn, sẽ KHÔNG bị đẩy lên GitHub.
#  Hướng dẫn lấy các giá trị dưới: setup-guides/01-neo4j-aura.md
# ==========================================================================

# Neo4j Aura Free — để trống thì hệ thống tự dùng đồ thị offline (graph.json)
#
# Cách nhanh nhất: khi tạo instance, Aura cho tải về một file .txt chứa sẵn
# đúng các dòng dưới đây. Mở file đó, chép toàn bộ nội dung vào .env là xong,
# không cần sửa gì.
#
# Lưu ý: Aura bản hiện hành dùng MÃ INSTANCE (chuỗi 8 ký tự, ví dụ a1b2c3d4)
# làm tên đăng nhập và làm luôn tên cơ sở dữ liệu — KHÔNG phải chuỗi "neo4j"
# như tài liệu cũ mô tả. Cứ chép nguyên giá trị Aura đưa, đừng tự sửa thành
# "neo4j", nếu không sẽ gặp lỗi AuthError hoặc DatabaseNotFound.

NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=xxxxxxxx
NEO4J_PASSWORD=
NEO4J_DATABASE=xxxxxxxx

# Hai biến dưới do Aura ghi kèm, hệ thống không dùng tới nhưng giữ lại cũng
# không sao — cứ để nguyên nếu bạn chép cả file từ Aura.
# AURA_INSTANCEID=xxxxxxxx
# AURA_INSTANCENAME=Free instance

# Tên cũ NEO4J_USER vẫn được chấp nhận, dùng thay cho NEO4J_USERNAME:
# NEO4J_USER=xxxxxxxx
